# Copy this file to .env.local and fill in the real values.
# .env.local is already in .gitignore — it will never be committed to git.

# Supabase: Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — used only by scripts/seed.ts and admin-only server code. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (optional for now — demo mode works without it)
ANTHROPIC_API_KEY=

# Optional: override the shared demo-login password (defaults to DemoPass123!)
DEMO_PASSWORD=

# Password for the /admin screen (switches the demo between industry
# templates). Defaults to "jobtrack-admin" if left blank — change this
# before showing the demo to anyone outside your own team.
ADMIN_PASSWORD=
